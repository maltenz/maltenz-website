---
import { getEntry } from 'astro:content';
import type { AboutEntry } from '../types/content';
import Layout from '../layouts/Layout.astro';
import Wrapper from '../components/Content';

// Get about content
const aboutData: AboutEntry = await getEntry('about', 'main') as AboutEntry;
const { Content } = await aboutData.render();
---

<Layout title="About - Malte">
  <Wrapper {...aboutData.data} client:load>
    <Content />
  </Wrapper>
</Layout>
