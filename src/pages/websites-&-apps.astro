---
import { getEntry } from 'astro:content';
import type {  WebsitesAppsEntry } from '../types/content';
import Layout from '../layouts/Layout.astro';
import Wrapper from '../components/Content';

// Get about content
const websitesAppsData: WebsitesAppsEntry = await getEntry('websites-apps', 'main') as WebsitesAppsEntry;
const { Content } = await websitesAppsData.render();
---

<Layout title="About - Malte">
  <Wrapper {...websitesAppsData.data} client:load>
    <Content />
  </Wrapper>
</Layout>
